{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash|PowerShell",
        "hooks": [
          {
            "type": "command",
            "command": "node \"$CLAUDE_PROJECT_DIR/scripts/hook-precommit-check.mjs\"",
            "timeout": 300,
            "statusMessage": "npm run check avant commit…"
          }
        ]
      }
    ]
  }
}
