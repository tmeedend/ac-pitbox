{
  "name": "pitbox",
  "version": "0.8.0",
  "description": "Pit Box — gestionnaire de mods Assetto Corsa",
  "type": "module",
  "scripts": {
    "predev": "npm run gen:licenses",
    "dev": "vite dev",
    "prebuild": "npm run gen:licenses",
    "build": "vite build",
    "preview": "vite preview",
    "precheck": "npm run gen:licenses && npm run check:locales && npm run check:version && npm run check:refs && npm run check:conventions && npm run report:docs && npm run report:code",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "precheck:watch": "npm run gen:licenses",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "gen:licenses": "node scripts/gen-licenses.mjs",
    "tauri": "tauri",
    "check:locales": "node scripts/check-locales.mjs",
    "check:version": "node scripts/check-version.mjs",
    "test": "vitest run",
    "verify": "npm run check && npm run test && npm run build && npm run verify:rust",
    "rules:diff": "cargo run -q --manifest-path src-tauri/Cargo.toml -p rules-tool -- diff",
    "rules:promote": "cargo run -q --manifest-path src-tauri/Cargo.toml -p rules-tool -- promote",
    "verify:rust": "cd src-tauri && cargo fmt --all --check && cargo clippy --workspace --all-targets -- -D warnings && cargo test --workspace",
    "version": "node scripts/sync-version.mjs && git add src-tauri/tauri.conf.json src-tauri/Cargo.toml src-tauri/Cargo.lock",
    "check:refs": "node scripts/check-refs.mjs",
    "check:conventions": "node scripts/check-conventions.mjs",
    "report:docs": "node scripts/report-docs.mjs",
    "report:code": "node scripts/report-code.mjs",
    "review:done": "node scripts/report-code.mjs --review-done"
  },
  "license": "MIT",
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-opener": "^2",
    "@types/three": "^0.185.4",
    "pdfjs-dist": "^6.2.108",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.9.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@tauri-apps/cli": "^2",
    "svelte": "^5.0.0",
    "svelte-check": "^4.0.0",
    "typescript": "~5.6.2",
    "vite": "^6.0.3",
    "vitest": "^5.0.0"
  }
}
